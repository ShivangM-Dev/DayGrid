{
  "name": "daygrid-database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx --env-file=.env.local migrate.ts",
    "migrate:init": "tsx migrate.ts init",
    "migrate:status": "tsx migrate.ts status",
    "migrate:reset": "tsx migrate.ts reset --force",
    "build": "tsc",
    "start": "node dist/migrate.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
