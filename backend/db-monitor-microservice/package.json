{
  "name": "daygrid-db-monitor",
  "version": "1.0.0",
  "description": "Microservice to monitor DayGrid database status every 2 hours",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env.local src/index.ts",
    "build": "tsc",
    "test": "tsx --env-file=.env.local src/test-connection.ts"
  },
  "keywords": ["database", "monitoring", "microservice", "supabase"],
  "author": "DayGrid Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}